# Environment reference for non-Infisical runs. Local scripts use Infisical dev app folders.
# Never commit actual credentials.
POSTGRES_PASSWORD=replace-with-local-admin-password
USER_API_DB_PASSWORD=replace-with-user-api-password
CATALOG_DB_PASSWORD=replace-with-catalog-password
CATALOG_SERVICE_TOKEN=replace-with-random-service-token
# Optional Twitch application credentials for IGDB; leave both empty to disable the integration.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Clerk keys are injected by Infisical for local web dev/preview:
# unplayd / dev / Web: NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY, NUXT_CLERK_SECRET_KEY
# User API session verification:
CLERK_ISSUER=https://set-gobbler-5479.clerk.accounts.dev
CLERK_AUTHORIZED_PARTY=http://localhost:8444
NUXT_APP_ORIGIN=http://localhost:8444
# Per-upstream timeout and shared BFF aggregation budget, including token acquisition.
NUXT_SERVICE_TIMEOUT_MS=3000
NUXT_REQUEST_TIMEOUT_MS=5000

# User API connection pool and PostgreSQL wait budgets (optional defaults).
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=1000
DATABASE_STATEMENT_TIMEOUT_MS=2000
DATABASE_LOCK_TIMEOUT_MS=1000
