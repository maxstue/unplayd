{
  "name": "@unplayd/catalog-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "go build -trimpath -o build/catalog-api ./cmd/catalog-api && go build -trimpath -o build/migrate ./cmd/migrate",
    "check": "vp run lint",
    "lint": "vp run format:check && go vet ./...",
    "format": "gofmt -w .",
    "format:check": "files=$(gofmt -l .) && test -z \"$files\"",
    "test": "go test -race -count=1 -v -coverprofile=coverage.out ./...",
    "dev": "DATABASE_URL=\"${CATALOG_DATABASE_URL:-postgresql://localhost:54329/unplayd?search_path=catalog&sslmode=disable}\" DATABASE_USER=catalog DATABASE_PASSWORD=\"$CATALOG_DB_PASSWORD\" go run ./cmd/catalog-api",
    "db:migrate": "docker compose run --build --rm --no-deps --entrypoint /migrate catalog-api"
  }
}
