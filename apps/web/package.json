{
  "name": "@unplayd/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --path=/Web -- nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "infisical run --env=dev --path=/Web -- node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint:eslint": "eslint . --max-warnings=0",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.test.json",
    "check": "vp run format:check && vp run lint && vp run typecheck",
    "lint": "vp lint --deny-warnings && vp run lint:eslint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run --coverage && vp run test:build",
    "test:build": "node --test --test-reporter=spec test/production/*.test.mjs"
  },
  "dependencies": {
    "@clerk/nuxt": "3.1.17",
    "h3": "1.15.11",
    "nuxt": "4.6.1",
    "openapi-fetch": "0.17.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vue-tsc": "3.3.13"
  }
}
