{
  "openapi": "3.0.3",
  "info": {
    "title": "Unplayd catalog-api",
    "version": "0.1.0",
    "description": "Internal catalog API for the Nuxt BFF and the user API. Search, detail and batch are answered from the catalog's PostgreSQL store; IGDB only supplements searches."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getCatalogLiveness",
        "summary": "Process liveness",
        "parameters": [
          {
            "$ref": "./common.json#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "$ref": "./common.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./common.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "./common.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "./common.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "./common.json#/components/responses/Conflict"
          },
          "503": {
            "$ref": "./common.json#/components/responses/Unavailable"
          }
        },
        "security": []
      }
    },
    "/games": {
      "get": {
        "operationId": "searchGames",
        "summary": "Search the catalog",
        "parameters": [
          {
            "$ref": "./common.json#/components/parameters/RequestId"
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          },
          {
            "name": "platformId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "description": "Repeatable category filter. Without it every parent appears once, carrying its matched children. With child categories the result is a flat list of matching games with their parent; game selects parents only. Several values combine as a union.",
            "schema": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 8,
              "items": {
                "$ref": "#/components/schemas/KindFilter"
              }
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Opaque cursor from nextCursor; clients must not construct or interpret it. It is only valid for the same query, kind filter and platformId; others are rejected with 400."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamePage"
                }
              }
            }
          },
          "400": {
            "$ref": "./common.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./common.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "./common.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "./common.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "./common.json#/components/responses/Conflict"
          },
          "503": {
            "$ref": "./common.json#/components/responses/Unavailable"
          }
        },
        "description": "Searches every kind of game. Editions, DLCs, expansions, remakes and other children are bundled under their parent unless a kind filter is given. Results come from stored games whose title contains every query word, plus games IGDB returned for the same query and kind filter; inactive games are excluded. Hits are ordered by best match (exact title, title prefix, every word, IGDB-only match), then title. The first page asks IGDB once the same query and kind filter were not answered by IGDB within 24 hours, waiting at most 2 seconds; follow-up pages never contact IGDB. When IGDB fails or is slow, stored games are returned and IGDB is not asked again for 30 seconds; without any stored match the response is 503."
      }
    },
    "/games/{gameId}": {
      "get": {
        "operationId": "getGame",
        "summary": "Get a game by stable internal UUID",
        "parameters": [
          {
            "$ref": "./common.json#/components/parameters/RequestId"
          },
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameDetail"
                }
              }
            }
          },
          "400": {
            "$ref": "./common.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./common.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "./common.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "./common.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "./common.json#/components/responses/Conflict"
          },
          "503": {
            "$ref": "./common.json#/components/responses/Unavailable"
          }
        },
        "description": "A parent lists its active children grouped by kind; a child references its parent and has no children. Answered from stored games only, so it stays available while IGDB is down. Inactive games remain readable with isActive false. A gameId that is not a UUID is rejected with 400."
      }
    },
    "/games/batch": {
      "post": {
        "operationId": "getGamesBatch",
        "summary": "Resolve a bounded batch without N+1 requests",
        "parameters": [
          {
            "$ref": "./common.json#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameBatchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "./common.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./common.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "./common.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "./common.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "./common.json#/components/responses/Conflict"
          },
          "503": {
            "$ref": "./common.json#/components/responses/Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameBatchRequest"
              }
            }
          }
        },
        "description": "Each requested ID appears exactly once in items, missingGameIds or inactiveGameIds. Result order is not guaranteed; associate by id. IDs match case-insensitively and are returned in lowercase; IDs that repeat in any case are rejected with 400. Children reference their parent so callers can group them; a batch may reference any stable game UUID, including children. Answered from stored games only, so it stays available while IGDB is down."
      }
    }
  },
  "security": [
    {
      "serviceToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Service token"
      }
    },
    "schemas": {
      "Platform": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "name"]
      },
      "GameKind": {
        "type": "string",
        "enum": [
          "game",
          "edition",
          "dlc",
          "expansion",
          "standalone_expansion",
          "pack",
          "update",
          "bundle",
          "remake",
          "remaster",
          "expanded_game",
          "port",
          "mod",
          "fork",
          "episode",
          "season"
        ],
        "description": "Kind of a catalog game. For children it is also the child type."
      },
      "KindFilter": {
        "type": "string",
        "enum": ["game", "dlc", "expansion", "edition", "remake", "port", "mod", "episode"],
        "description": "Search category. game: parents. dlc: dlc, pack, update. expansion: expansion, standalone_expansion. edition: edition, bundle, expanded_game. remake: remake, remaster. port: port. mod: mod, fork. episode: episode, season."
      },
      "Game": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "$ref": "#/components/schemas/GameKind"
          },
          "parent": {
            "type": "object",
            "nullable": true,
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["id", "title"],
            "description": "Parent of a child game; null for parents. The hierarchy has a single level."
          },
          "coverUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "platforms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Platform"
            }
          },
          "isActive": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO-8601 timestamp with Z suffix."
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "parent",
          "coverUrl",
          "platforms",
          "isActive",
          "updatedAt"
        ]
      },
      "KindCount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/GameKind"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["kind", "count"]
      },
      "ChildGroup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/GameKind"
          },
          "games": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Game"
            },
            "description": "Sorted by title."
          }
        },
        "required": ["kind", "games"]
      },
      "GameDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "game": {
            "$ref": "#/components/schemas/Game"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChildGroup"
            },
            "description": "Active children grouped by kind in GameKind order; empty for children."
          }
        },
        "required": ["game", "children"]
      },
      "GameSearchHit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "game": {
            "$ref": "#/components/schemas/Game"
          },
          "childCounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KindCount"
            },
            "description": "Active children per kind in GameKind order; empty for children."
          },
          "matchedChildren": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Game"
            },
            "description": "Children of this parent that matched the query. Only filled without a kind filter."
          }
        },
        "required": ["game", "childCounts", "matchedChildren"]
      },
      "GamePage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameSearchHit"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "nextCursor"],
        "example": {
          "items": [],
          "nextCursor": null
        }
      },
      "GameBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gameIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": ["gameIds"]
      },
      "GameBatchResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Game"
            }
          },
          "missingGameIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "inactiveGameIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": ["items", "missingGameIds", "inactiveGameIds"]
      }
    }
  }
}
