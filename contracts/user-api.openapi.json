    "/next-game": {
      "get": {
        "operationId": "drawNextGame",
        "summary": "Read-only uniform selection from the full own backlog",
        "parameters": [
          {
            "$ref": "./common.json#/components/parameters/RequestId"
          },
          {
            "name": "platformId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "excludeGameId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextGame"
                }
              }
            }
          },
          "400": {
            "$ref": "./common.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./common.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "./common.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "./common.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "./common.json#/components/responses/Conflict"
          },
          "503": {
            "$ref": "./common.json#/components/responses/Unavailable"
          }
        },
        "description": "All matching backlog entries are equally likely, across the whole result set. Exclude the previous game only when alternatives exist. A single candidate remains selectable. No candidate returns entry:null. Only PUT /library/{gameId}/status changes status."
      }
    }
  },
  "security": [
    {
      "clerkSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "clerkSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GameSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "coverUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        },
        "required": ["title", "coverUrl"]
      },
      "LibraryEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "platformId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "ownership": {
            "$ref": "./common.json#/components/schemas/Ownership"
          },
          "status": {
            "$ref": "./common.json#/components/schemas/PlayStatus"
          },
          "favorite": {
            "type": "boolean"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "nullable": true
          },
          "note": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "snapshot": {
            "$ref": "#/components/schemas/GameSnapshot"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "gameId",
          "platformId",
          "ownership",
          "status",
          "favorite",
          "rating",
          "note",
          "snapshot",
          "createdAt",
          "updatedAt"
        ]
      },
      "LibraryPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryEntry"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "nextCursor"],
        "example": {
          "items": [],
          "nextCursor": null
        }
      },
      "AddLibraryEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "ownership": {
            "$ref": "./common.json#/components/schemas/Ownership"
          },
          "platformId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": ["gameId", "ownership"]
      },
      "SetStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "./common.json#/components/schemas/PlayStatus"
          }
        },
        "required": ["status"]
      },
      "SetRating": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": ["value"]
      },
      "SetNote": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": ["text"]
      },
      "NextGame": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LibraryEntry"
              }
            ],
            "nullable": true,
            "description": "Null when no matching own backlog entry exists; selection never changes state.",
            "type": "object"
          }
        },
        "required": ["entry"]
      }
    }
  }
}
