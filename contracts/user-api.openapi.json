    },
    "/library": {
      "get": {
        "operationId": "listLibrary",
        "summary": "List the authenticated user library",
        "parameters": [
          {
            "$ref": "./common.json#/components/parameters/RequestId"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "./common.json#/components/schemas/PlayStatus"
            }
          },
          {
            "name": "ownership",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "./common.json#/components/schemas/Ownership"
            }
          },
          {
            "name": "platformId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Opaque cursor; clients must not construct or interpret it."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
