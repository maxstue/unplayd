              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryPage"
                }
              }
            }
          },
          "400": {
            "$ref": "./common.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./common.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "./common.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "./common.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "./common.json#/components/responses/Conflict"
          },
          "503": {
            "$ref": "./common.json#/components/responses/Unavailable"
          }
        }
      },
      "post": {
        "operationId": "addLibraryEntry",
        "summary": "Add a game to the own library",
        "parameters": [
          {
            "$ref": "./common.json#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryEntry"
                }
              }
            }
          },
          "400": {
            "$ref": "./common.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./common.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "./common.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "./common.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "./common.json#/components/responses/Conflict"
          },
          "503": {
            "$ref": "./common.json#/components/responses/Unavailable"
          },
          "200": {
            "description": "Existing matching entry; no state overwritten.",
            "headers": {
              "X-Request-ID": {
                "$ref": "./common.json#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryEntry"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddLibraryEntry"
              }
            }
          }
        },
        "description": "Validate game and optional platform through catalog-api before an atomic write. A repeated identical request returns the existing entry without overwriting ownership/status; conflicting existing data returns 409. Catalog unavailability returns 503 without a partial entry."
      }
    },
