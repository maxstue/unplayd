{
  "name": "unplayd",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @unplayd/web#dev",
    "dev:user-api": "node --env-file=.env scripts/backend.mjs user-api dev",
    "dev:catalog-api": "node --env-file=.env scripts/backend.mjs catalog-api dev",
    "build": "vp run build:web && vp run build:user-api && vp run build:catalog-api",
    "build:web": "vp run @unplayd/web#build",
    "build:user-api": "node scripts/backend.mjs user-api build",
    "build:catalog-api": "node scripts/backend.mjs catalog-api build",
    "check": "vp run contracts:check && vp run check:web && vp run check:user-api && vp run check:catalog-api",
    "check:web": "vp fmt --check && vp lint --deny-warnings && vp run @unplayd/web#lint:eslint && vp run @unplayd/web#typecheck",
    "check:user-api": "node scripts/backend.mjs user-api check",
    "check:catalog-api": "node scripts/backend.mjs catalog-api check",
    "lint": "vp lint --deny-warnings && vp run @unplayd/web#lint:eslint && vp run lint:user-api && vp run lint:catalog-api",
    "lint:user-api": "node scripts/backend.mjs user-api lint",
    "lint:catalog-api": "node scripts/backend.mjs catalog-api lint",
    "typecheck": "vp run @unplayd/web#typecheck",
    "format": "vp fmt && vp run format:user-api && vp run format:catalog-api",
    "format:user-api": "node scripts/backend.mjs user-api format",
    "format:catalog-api": "node scripts/backend.mjs catalog-api format",
    "test": "vp run test:web && vp run test:user-api && vp run test:catalog-api",
    "test:web": "vp test run --coverage",
    "test:user-api": "node scripts/backend.mjs user-api test",
    "test:catalog-api": "node scripts/backend.mjs catalog-api test",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:user-api": "node scripts/migrate.mjs user-api",
    "db:migrate:catalog-api": "node scripts/migrate.mjs catalog-api",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@vitest/coverage-v8": "5.0.4",
    "openapi-typescript": "7.13.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0 <25 || >=26.0.0 <27"
  },
  "packageManager": "pnpm@12.11.2"
}
