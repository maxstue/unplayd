    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0 <25 || >=26.0.0 <27"
  },
  "packageManager": "pnpm@12.11.2"
}
