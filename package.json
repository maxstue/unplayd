{
  "name": "unplayd",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter \"@unplayd/*\" --parallel dev",
    "dev:user-api": "vp run @unplayd/user-api#dev",
    "dev:catalog-api": "vp run @unplayd/catalog-api#dev",
    "build": "vp run --filter \"@unplayd/*\" build",
    "build:web": "vp run @unplayd/web#build",
    "build:user-api": "vp run @unplayd/user-api#build",
    "build:catalog-api": "vp run @unplayd/catalog-api#build",
    "check": "vp run contracts:check && vp run check:repo && vp run --filter \"@unplayd/*\" check",
    "check:web": "vp run @unplayd/web#check",
    "check:user-api": "vp run @unplayd/user-api#check",
    "check:catalog-api": "vp run @unplayd/catalog-api#check",
    "lint": "vp run lint:repo && vp run --filter \"@unplayd/*\" lint",
    "lint:user-api": "vp run @unplayd/user-api#lint",
    "lint:catalog-api": "vp run @unplayd/catalog-api#lint",
    "typecheck": "vp run @unplayd/web#typecheck",
    "format": "vp run format:repo && vp run --filter \"@unplayd/*\" format",
    "format:user-api": "vp run @unplayd/user-api#format",
    "format:catalog-api": "vp run @unplayd/catalog-api#format",
    "test": "vp run --filter \"@unplayd/*\" test",
    "test:web": "vp run @unplayd/web#test",
    "test:user-api": "vp run @unplayd/user-api#test",
    "test:catalog-api": "vp run @unplayd/catalog-api#test",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "vp run --filter \"@unplayd/*\" db:migrate",
    "db:migrate:user-api": "vp run @unplayd/user-api#db:migrate",
    "db:migrate:catalog-api": "vp run @unplayd/catalog-api#db:migrate",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "format:check": "vp run format:repo:check && vp run --filter \"@unplayd/*\" format:check",
    "dev:web": "vp run @unplayd/web#dev",
    "check:repo": "vp run format:repo:check && vp run lint:repo",
    "format:repo": "vp fmt package.json pnpm-workspace.yaml README.md renovate.json contracts infra .github scripts apps/user-api/package.json apps/catalog-api/package.json",
    "format:repo:check": "vp fmt --check package.json pnpm-workspace.yaml README.md renovate.json contracts infra .github scripts apps/user-api/package.json apps/catalog-api/package.json",
    "lint:repo": "vp lint --deny-warnings scripts",
    "lint:web": "vp run @unplayd/web#lint",
    "format:web": "vp run @unplayd/web#format"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "openapi-typescript": "7.13.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0 <25 || >=26.0.0 <27"
  },
  "packageManager": "pnpm@12.11.2"
}
