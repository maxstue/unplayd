{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    ":timezone(Europe/Berlin)"
  ],
  "assignees": ["maxstue"],
  "reviewers": ["maxstue"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "2 days",
  "rangeStrategy": "bump",
  "schedule": ["before 8am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am on monday"],
    "commitMessageAction": "refresh"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "automerge": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.go$/", "/\\.kt$/"],
      "matchStrings": [
        "renovate: datasource=docker depName=(?<depName>[^\\s]+)\\s+(?:const|val) image = \"[^\"]+:(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    { "matchManagers": ["github-actions"], "groupName": "github actions" },
    {
      "matchDatasources": ["docker"],
      "groupName": "docker images"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "frontend packages"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "vite",
        "@vitest/coverage-v8"
      ],
      "groupName": "vite-plus toolchain",
      "groupSlug": "vite-plus-toolchain"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "kotlin packages"
    },
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true }
  ]
}
